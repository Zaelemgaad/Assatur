+		private static ControllerFunction[] CreateVisibleBindings()
+		{
+			List<ControllerFunction> list = new List<ControllerFunction>();
+			for (int i = 0; i < (int)ControllerFunction.NR_OF_FUNCTIONS; i++)
+			{
+				ControllerFunction controllerFunction = (ControllerFunction)i;
+				if (IsVisibleBinding(controllerFunction))
+				{
+					list.Add(controllerFunction);
+				}
+			}
+			return list.ToArray();
+		}
+
+		private static bool IsVisibleBinding(ControllerFunction iFunction)
+		{
+			return iFunction != ControllerFunction.Spell_Right && iFunction != ControllerFunction.Spell_Up && iFunction != ControllerFunction.Spell_Left && iFunction != ControllerFunction.Spell_Down && iFunction != ControllerFunction.Special && iFunction != ControllerFunction.Spell_Wheel;
+		}
+
+		private static ControllerFunction GetBindingFunction(int iIndex)
+		{
+			return VISIBLE_BINDINGS[iIndex];
+		}
+
+		private static int GetBindingMenuPosition(ControllerFunction iFunction)
+		{
+			for (int i = 0; i < VISIBLE_BINDINGS.Length; i++)
+			{
+				if (VISIBLE_BINDINGS[i] == iFunction)
+				{
+					return i + 1;
+				}
+			}
+			return -1;
+		}
