+		public static Binding[] CreateDefaultBindings()
+		{
+			Binding[] array = new Binding[BindingCount];
+			for (int i = 0; i < array.Length; i++)
+			{
+				array[i] = GetDefaultBinding((ControllerFunction)i);
+			}
+			return array;
+		}
+
+		public static Binding[] EnsureBindings(Binding[] iBindings)
+		{
+			int oldLength = (iBindings == null) ? 0 : iBindings.Length;
+			if (oldLength == BindingCount)
+			{
+				UpgradeLegacyBindings(iBindings);
+				return iBindings;
+			}
+			Binding[] array = new Binding[BindingCount];
+			int copyLength = Math.Min(oldLength, BindingCount);
+			for (int i = 0; i < copyLength; i++)
+			{
+				array[i] = iBindings[i];
+			}
+			for (int j = copyLength; j < array.Length; j++)
+			{
+				array[j] = GetDefaultBinding((ControllerFunction)j);
+			}
+			if (oldLength == 0)
+			{
+				for (int k = 0; k < array.Length; k++)
+				{
+					array[k] = GetDefaultBinding((ControllerFunction)k);
+				}
+			}
+			else
+			{
+				UpgradeLegacyBindings(array);
+			}
+			return array;
+		}
+
+		public static void EnsureGlobalBindings()
+		{
+			GlobalSettings instance = GlobalSettings.Instance;
+			for (int i = 0; i < instance.XInputBindings.Length; i++)
+			{
+				instance.XInputBindings[i] = EnsureBindings(instance.XInputBindings[i]);
+			}
+		}
