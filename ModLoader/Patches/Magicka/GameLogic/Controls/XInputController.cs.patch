+		private static void UpgradeLegacyBindings(Binding[] iBindings)
+		{
+			if (iBindings[(int)ControllerFunction.Cast_Force].Type == Binding.BindingType.None)
+			{
+				iBindings[(int)ControllerFunction.Cast_Force] = GetDefaultBinding(ControllerFunction.Cast_Force);
+			}
+			else if (iBindings[(int)ControllerFunction.Cast_Force].Type == Binding.BindingType.Button && iBindings[(int)ControllerFunction.Cast_Force].BindingIndex == (int)Buttons.RightStick)
+			{
+				iBindings[(int)ControllerFunction.Cast_Force] = GetDefaultBinding(ControllerFunction.Cast_Force);
+			}
+			if (iBindings[(int)ControllerFunction.Special].Type == Binding.BindingType.Button && iBindings[(int)ControllerFunction.Special].BindingIndex == (int)Buttons.RightStick)
+			{
+				iBindings[(int)ControllerFunction.Special] = GetDefaultBinding(ControllerFunction.Special);
+			}
+		}
+
+		private static string GetBindingPartName(Binding.BindingType iType, int iIndex)
+		{
+			switch (iType)
+			{
+			case Binding.BindingType.Button:
+				if (iIndex == 0)
+				{
+					return "-";
+				}
+				return GetButtonName((Buttons)iIndex);
+			case Binding.BindingType.Trigger:
+				if (iIndex == 0)
+				{
+					return GetButtonName(Buttons.LeftTrigger);
+				}
+				if (iIndex == 1)
+				{
+					return GetButtonName(Buttons.RightTrigger);
+				}
+				return "-";
+			case Binding.BindingType.PositiveStick:
+				if (iIndex == 0)
+				{
+					return GetButtonName(Buttons.LeftThumbstickRight);
+				}
+				if (iIndex == 1)
+				{
+					return GetButtonName(Buttons.LeftThumbstickUp);
+				}
+				if (iIndex == 2)
+				{
+					return GetButtonName(Buttons.RightThumbstickRight);
+				}
+				if (iIndex == 3)
+				{
+					return GetButtonName(Buttons.RightThumbstickUp);
+				}
+				return "-";
+			case Binding.BindingType.NegativeStick:
+				if (iIndex == 0)
+				{
+					return GetButtonName(Buttons.LeftThumbstickLeft);
+				}
+				if (iIndex == 1)
+				{
+					return GetButtonName(Buttons.LeftThumbstickDown);
+				}
+				if (iIndex == 2)
+				{
+					return GetButtonName(Buttons.RightThumbstickLeft);
+				}
+				if (iIndex == 3)
+				{
+					return GetButtonName(Buttons.RightThumbstickDown);
+				}
+				return "-";
+			case Binding.BindingType.StickMagnitude:
+				if (iIndex == 0)
+				{
+					return "Left Stick Direction";
+				}
+				if (iIndex == 1)
+				{
+					return "Right Stick Direction";
+				}
+				return "-";
+			default:
+				return "-";
+			}
+		}
