+		public static void WriteBinding(BinaryWriter iWriter, Binding iBinding)
+		{
+			iWriter.Write((byte)iBinding.Type);
+			iWriter.Write(iBinding.BindingIndex);
+			iWriter.Write((byte)iBinding.ModifierType);
+			iWriter.Write(iBinding.ModifierBindingIndex);
+		}
+
+		public static Binding ReadBinding(BinaryReader iReader)
+		{
+			Binding binding = default(Binding);
+			binding.Type = (Binding.BindingType)iReader.ReadByte();
+			binding.BindingIndex = iReader.ReadInt32();
+			binding.ModifierType = (Binding.BindingType)iReader.ReadByte();
+			binding.ModifierBindingIndex = iReader.ReadInt32();
+			return binding;
+		}
+
+		public static string GetBindingName(Binding iBinding)
+		{
+			string text = GetBindingPartName(iBinding.Type, iBinding.BindingIndex);
+			if (text == "-")
+			{
+				return text;
+			}
+			string text2 = GetBindingPartName(iBinding.ModifierType, iBinding.ModifierBindingIndex);
+			if (text2 == "-")
+			{
+				return text;
+			}
+			return text2 + " + " + text;
+		}
