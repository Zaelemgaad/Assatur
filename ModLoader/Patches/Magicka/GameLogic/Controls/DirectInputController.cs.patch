+			{
+				return iBindings;
+			}
+			Binding[] array = new Binding[BindingCount];
+			int copyLength = Math.Min(oldLength, BindingCount);
+			for (int i = 0; i < copyLength; i++)
+			{
+				array[i] = iBindings[i];
+			}
+			return array;
+		}
