+		public bool CastTomeMagick()
+		{
+			if (mCurrentState is ChargeState || mPolymorphed || !mCanChant || !TutorialManager.Instance.IsCastTypeEnabled(CastType.Magick))
+			{
+				return false;
+			}
+			MagickType tomeMagick = Player.IconRenderer.TomeMagick;
+			if (tomeMagick == MagickType.None || !SpellManager.Instance.IsMagickAllowed(Player, mPlayState.GameType, tomeMagick))
+			{
+				return false;
+			}
+			Elements[] magickCombo = SpellManager.Instance.GetMagickCombo(tomeMagick);
+			if (magickCombo == null)
+			{
+				return false;
+			}
+			if (tomeMagick == MagickType.Amalgameddon)
+			{
+				magickCombo = new Elements[4]
+				{
+					Elements.Arcane,
+					Elements.Ice,
+					Elements.Lightning,
+					Elements.Fire
+				};
+			}
+			Player.IconRenderer.Clear();
+			Player.InputQueue.Clear();
+			mSpellQueue.Clear();
+			mChantedSpells = 0;
+			for (int i = 0; i < magickCombo.Length; i++)
+			{
+				Spell iSpell;
+				Spell.DefaultSpell(magickCombo[i], out iSpell);
+				if (NetworkManager.Instance.State != 0)
+				{
+					CharacterActionMessage iMessage = default(CharacterActionMessage);
+					iMessage.Action = ActionType.ConjureElement;
+					iMessage.Handle = base.Handle;
+					iMessage.Param0I = (int)iSpell.Element;
+					NetworkManager.Instance.Interface.SendMessage(ref iMessage);
+				}
+				if (SpellManager.Instance.TryAddToQueue(Player, this, mSpellQueue, mSpellQueue.Capacity, ref iSpell))
+				{
+					mChantedSpells++;
+				}
+				int iSoundIndex = Defines.SOUNDS_UI_ELEMENT[Spell.ElementIndex(iSpell.Element)];
+				AudioManager.Instance.PlayCue(Banks.UI, iSoundIndex);
+			}
+			mChantingMagick = SpellManager.Instance.IsMagick(Player, mPlayState.GameType, base.SpellQueue);
+			if (!mChantingMagick)
+			{
+				return false;
+			}
+			TutorialManager.Instance.SetTip(TutorialManager.Tips.MagicksSpell, TutorialManager.Position.Top);
+			Boost();
+			return true;
+		}
+
